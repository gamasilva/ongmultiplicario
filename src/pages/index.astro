<style>
  .slideshow-slide {
    transition: opacity 1.5s ease-in-out;
  }
  .slideshow-image {
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1.08);
  }
  .slideshow-slide.active .slideshow-image {
    transform: scale(1);
  }

  /* Linhas e Formas Diagonais / Chevrons (Estilo Vini Jr) */
  .decor-chevron-left {
    position: absolute;
    width: 120px;
    height: 120px;
    border-bottom: 24px solid var(--color-primary-dark);
    border-left: 24px solid var(--color-primary-dark);
    transform: rotate(45deg);
    opacity: 0.25;
    pointer-events: none;
    z-index: 0;
  }
  .decor-chevron-right {
    position: absolute;
    width: 180px;
    height: 180px;
    border-top: 32px solid var(--color-primary-dark);
    border-right: 32px solid var(--color-primary-dark);
    transform: rotate(45deg);
    opacity: 0.25;
    pointer-events: none;
    z-index: 0;
  }
  .decor-slanted-stripe {
    position: absolute;
    width: 150%;
    height: 80px;
    background: linear-gradient(90deg, var(--color-primary-dark) 0%, transparent 100%);
    transform: rotate(-12deg) translateX(-10%);
    opacity: 0.2;
    pointer-events: none;
    z-index: 0;
  }
  .decor-slanted-stripe-accent {
    position: absolute;
    width: 150%;
    height: 100px;
    background: linear-gradient(90deg, var(--color-primary-dark) 0%, transparent 100%);
    transform: rotate(12deg) translateX(-10%);
    opacity: 0.2;
    pointer-events: none;
    z-index: 0;
  }

  /* ───── OVERDRIVE: SCROLL-DRIVEN ANIMATIONS ───── */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      #hero-slideshow {
        animation: parallax-hero-bg linear both;
        animation-timeline: scroll(root);
        animation-range: exit 0% exit 100%;
      }
      #hero-content {
        animation: fade-out-hero linear both;
        animation-timeline: scroll(root);
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .decor-chevron-left {
        animation: scroll-decor-left linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .decor-chevron-right {
        animation: scroll-decor-right linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .decor-slanted-stripe {
        animation: scroll-stripe-left linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .decor-slanted-stripe-accent {
        animation: scroll-stripe-right linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes fade-out-hero {
    to {
      opacity: 0;
      transform: translateY(-80px);
    }
  }

  @keyframes parallax-hero-bg {
    to {
      transform: translateY(120px);
    }
  }

  @keyframes scroll-decor-left {
    from {
      transform: rotate(40deg) translateY(-20px);
      opacity: 0.15;
    }
    to {
      transform: rotate(50deg) translateY(40px);
      opacity: 0.35;
    }
  }

  @keyframes scroll-decor-right {
    from {
      transform: rotate(50deg) translateY(20px);
      opacity: 0.15;
    }
    to {
      transform: rotate(40deg) translateY(-40px);
      opacity: 0.35;
    }
  }

  @keyframes scroll-stripe-left {
    from {
      transform: rotate(-14deg) translateX(-15%);
      opacity: 0.1;
    }
    to {
      transform: rotate(-10deg) translateX(-5%);
      opacity: 0.25;
    }
  }

