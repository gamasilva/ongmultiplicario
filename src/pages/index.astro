---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DonateButton from '../components/DonateButton.astro';
import { HeartPulse, Heart, BookOpen, Brush, TreePine, Users, ChevronLeft, ChevronRight, Calendar, ArrowRight, Copy, QrCode, CreditCard, Gift, Building2, FileText, Download, ShieldCheck, MapPin, Phone, Mail } from 'lucide-astro';

const videoPoster = await getImage({
  src: "https://i.ibb.co/8gYZqnX7/Whats-App-Image-2026-06-22-at-07-27-58-2.jpg",
  inferSize: true,
  width: 600,
});

// Mesma imagem e largura usadas no primeiro slide do hero (fetchpriority="high"),
// para que o preload no <head> aponte para o arquivo otimizado real, não o original.
const heroImageOptimized = await getImage({
  src: "https://i.ibb.co/QvjF1f6q/Whats-App-Image-2026-06-22-at-07-28-01-2.jpg",
  inferSize: true,
  width: 1600,
});

const title = "Início";
const fullTitle = "Instituto MultiplicaRio | Educação e Saúde na Penha, Rio de Janeiro";
const description = "Instituto MultiplicaRio: saúde, educação e assistência social gratuitas na Penha, Rio de Janeiro. OSCIP credenciada.";
const keywords = "MultiplicaRio, ONG Penha, saúde gratuita Penha, assistência social Rio de Janeiro, OSCIP Rio de Janeiro, educação comunitária, voluntariado Penha, orientação INSS LOAS BPC Penha, Instituto MultiplicaRio";
const heroImage = heroImageOptimized.src;

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.imultiplicario.com.br/#webpage",
  "url": "https://www.imultiplicario.com.br/",
  "name": fullTitle,
  "description": description,
  "isPartOf": { "@id": "https://www.imultiplicario.com.br/#website" },
  "about": { "@id": "https://www.imultiplicario.com.br/#organization" },
  "inLanguage": "pt-BR",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://www.imultiplicario.com.br/" }
    ]
  }
};
---

<BaseLayout title={title} fullTitle={fullTitle} description={description} keywords={keywords} heroImage={heroImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  </Fragment>

  <!-- ───── HERO ───── -->
  <section class="relative bg-primary/15 min-h-[100vh] flex flex-col justify-between pt-12 sm:pt-16 lg:pt-20 pb-12 lg:pb-0">
    <!-- Imagens de fundo (Slideshow com zoom-out / Ken Burns) -->
    <div class="absolute inset-0 z-0 overflow-hidden" id="hero-slideshow">
      <div class="absolute inset-0 slideshow-slide opacity-100 active">
        <Image
          src="https://i.ibb.co/QvjF1f6q/Whats-App-Image-2026-06-22-at-07-28-01-2.jpg"
          inferSize
          width={1600}
          alt="Atendimento de saúde na comunidade"
          class="w-full h-full object-cover object-top slideshow-image"
          fetchpriority="high" loading="eager" decoding="async"
        />
      </div>
      <div class="absolute inset-0 slideshow-slide opacity-0">
        <Image
          src="https://i.ibb.co/8gYZqnX7/Whats-App-Image-2026-06-22-at-07-27-58-2.jpg"
          inferSize
          width={1600}
          alt="Crianças estudando"
          class="w-full h-full object-cover object-top slideshow-image"
          loading="lazy" decoding="async"
        />
      </div>
      <div class="absolute inset-0 slideshow-slide opacity-0">
        <Image
          src="https://i.ibb.co/JPpm3ZD/Whats-App-Image-2026-06-22-at-07-28-01.jpg"
          inferSize
          width={1600}
          alt="Ação cultural"
          class="w-full h-full object-cover object-top slideshow-image"
          loading="lazy" decoding="async"
        />
      </div>
      <div class="absolute inset-0 slideshow-slide opacity-0">
        <Image
          src="https://i.ibb.co/Fbg433Kj/Whats-App-Image-2026-06-22-at-07-28-01-1.jpg"
          inferSize
          width={1600}
          alt="Voluntários e comunidade reunida"
          class="w-full h-full object-cover object-top slideshow-image"
          loading="lazy" decoding="async"
        />
      </div>

      <!-- Gradiente claro direcional (sobreposto a todos os slides) -->
      <div class="absolute inset-0 bg-gradient-to-r from-bg-offwhite/90 via-bg-offwhite/60 to-bg-offwhite/10 z-10"></div>
      <!-- Gradiente vertical inferior -->
      <div class="absolute inset-0 bg-gradient-to-t from-bg-offwhite/60 via-transparent to-transparent z-10"></div>
    </div>

    <!-- Textura -->
    <div class="absolute top-0 right-0 w-1/2 h-full dot-pattern opacity-40 pointer-events-none z-10"></div>

    <div class="flex-grow flex items-center w-full">
      <div id="hero-content" class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-8 sm:py-12 md:py-20">
        <div class="max-w-3xl space-y-5 sm:space-y-7 md:space-y-9">
          <!-- Heading -->
          <h1 class="font-serif text-[1.85rem] xs:text-3xl sm:text-5xl md:text-6xl lg:text-[4.5rem] font-bold leading-tight animate-fade-up animate-fade-up-delay-1">
            Multiplicando esperança,<br/>
            <span class="inline-block bg-accent text-white px-3 sm:px-6 py-1 sm:py-2 rounded-xl sm:rounded-2xl transform -rotate-1 shadow-lg mt-3 text-[1.45rem] xs:text-2xl sm:text-4xl lg:text-[3.8rem] leading-none select-none">transformando vidas</span>
          </h1>

          <!-- Botões -->
          <div class="hidden sm:flex flex-row gap-3 sm:gap-4 pt-2 animate-fade-up animate-fade-up-delay-3">
            <DonateButton variant="primary" class="w-full sm:w-auto justify-center text-base sm:text-lg px-8 py-4" />
            <a
              href="#sobre"
              class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-primary-dark text-white hover:bg-primary-dark/90 px-8 py-4 rounded-full font-bold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-primary-dark focus-visible:ring-offset-bg-offwhite text-base sm:text-lg shadow-md"
            >
              Conheça nosso trabalho
            </a>
          </div>

          
        </div>
      </div>
    </div>

    <!-- Overlapping Cards at the bottom -->
    <div class="relative z-20 w-full translate-y-[20%] sm:translate-y-1/2 lg:translate-y-1/2 mt-auto">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
        <div class="grid grid-cols-2 lg:grid-cols-4 rounded-3xl overflow-hidden shadow-2xl border border-primary-dark/10">
          {[
            { value: "Desde 2014", label: "na Penha, Rio de Janeiro" },
            { value: "+500 famílias", label: "atendidas até hoje" },
            { value: "100% gratuito", label: "todos os nossos serviços" },
            { value: "OSCIP", label: "credenciada pelo MJ" },
          ].map((item, index) => {
            const isDark = index % 2 !== 0;
            return (
              <div class={`relative overflow-hidden flex flex-col justify-center p-3 sm:p-8 min-h-[85px] sm:min-h-[130px] md:min-h-[170px] ${
                isDark ? 'bg-primary-dark text-white' : 'bg-white text-primary-dark'
              }`}>
                <div class={`absolute right-2 bottom-1 text-4xl sm:text-7xl md:text-8xl font-sans font-bold select-none pointer-events-none ${
                  isDark ? 'opacity-20 text-primary' : 'opacity-[0.08] text-primary-dark'
                }`}>
                  +
                </div>
                <div class="font-sans font-black italic text-sm sm:text-3xl lg:text-[2.2rem] xl:text-[2.6rem] leading-none tracking-tight">
                  {item.value}
                </div>
                <div class="text-[9px] sm:text-sm mt-1 font-medium leading-snug opacity-80">
                  {item.label}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ───── QUEM SOMOS ───── -->
  <section id="sobre" class="py-24 md:py-32 bg-bg-offwhite relative overflow-hidden">
    <!-- Linhas e formas decorativas (Estilo Vini Jr) -->
    <div class="decor-chevron-left top-16 -left-12"></div>
    <div class="decor-slanted-stripe top-1/4 left-0"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      
      <!-- Linha 1: História + Missão -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-20">
        
        <!-- Esquerda: Sobre o Instituto -->
        <div class="lg:col-span-5 space-y-6">
          <h2 class="font-serif text-3xl md:text-4xl xl:text-5xl font-bold leading-tight">
            Sobre o Instituto
          </h2>
          <p class="text-base sm:text-lg text-text-body/75 leading-relaxed">
            O Instituto MultiplicaRio é a realização do sonho de voluntários e parceiros da comunidade da Penha de contribuir com a transformação social, da saúde e da educação comunitária na região do Rio de Janeiro. A atuação acontece diretamente na comunidade, utilizando serviços essenciais como base, e a solidariedade humana como ferramenta de aprendizado e desenvolvimento.
          </p>
          <p class="text-base sm:text-lg text-text-body/75 leading-relaxed">
            A partir dessa combinação, o Instituto desenvolve ações de atendimento em saúde e bem-estar, apoio jurídico comunitário, natação infantil e hidroginástica, reforço escolar, cultura carioca e capacitação profissional.
          </p>
          
          <div class="pt-2">
            <div class="inline-flex items-center gap-3 p-4 bg-primary/15 rounded-3xl border border-primary/25">
              <div class="w-12 h-12 bg-primary-dark text-primary rounded-2xl flex items-center justify-center font-serif font-black text-xl">
                MR
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] uppercase tracking-wider text-text-body/85 font-bold block mb-1">BALANÇO</span>
                <span class="text-sm font-serif font-bold text-primary-dark">MultiplicaRio</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Direita: Imagem Grande + Missão -->
        <div class="lg:col-span-7 space-y-8">
          <div class="aspect-[16/10] rounded-3xl overflow-hidden shadow-xl ring-1 ring-gray-200">
            <Image
              src="https://i.ibb.co/SwbBypjX/Whats-App-Image-2026-06-22-at-07-28-02-3.jpg"
              inferSize
              width={800}
              alt="Voluntários e comunidade em ação"
              class="w-full h-full object-cover"
              loading="lazy" decoding="async"
            />
          </div>
          
          <div class="bg-primary-dark p-8 rounded-3xl shadow-lg border border-primary-dark/15 space-y-3 text-white">
            <h3 class="font-serif text-2xl font-bold text-primary uppercase tracking-tight">Missão</h3>
            <p class="text-white/85 text-sm sm:text-base leading-relaxed">
              Atuar nas áreas de educação, saúde, esportes, lazer, cultura, meio ambiente, capacitação profissional e assistência social, promovendo ações gratuitas e integradas para acolher famílias e construir uma sociedade mais justa e digna.
            </p>
          </div>
        </div>

      </div>

      <!-- Linha 2: Visão + Crenças (Grid de 2 Colunas) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-start">
        
        <!-- Coluna Visão -->
        <div class="space-y-6">
          <div class="aspect-[16/10] rounded-3xl overflow-hidden shadow-lg ring-1 ring-gray-200">
            <Image
              src="https://i.ibb.co/FbBTGmbF/Whats-App-Image-2026-06-22-at-07-28-02-1.jpg"
              inferSize
              width={600}
              alt="Crianças estudando"
              class="w-full h-full object-cover"
              loading="lazy" decoding="async"
            />
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-2xl font-bold text-primary-dark uppercase tracking-tight">Visão</h3>
            <p class="text-text-body/75 text-sm sm:text-base leading-relaxed">
              Ser referência na transformação social da Penha e do Rio de Janeiro, sendo reconhecida pela transparência de suas atividades, pelo impacto real direto na vida das pessoas e pelo acolhimento humano.
            </p>
          </div>
        </div>

        <!-- Coluna Crenças -->
        <div class="space-y-6">
          <div class="aspect-[16/10] rounded-3xl overflow-hidden shadow-lg ring-1 ring-gray-200">
            <Image
              src="https://i.ibb.co/7Jh8fYQj/Whats-App-Image-2026-06-22-at-07-28-02.jpg"
              inferSize
              width={600}
              alt="Saúde comunitária"
              class="w-full h-full object-cover"
              loading="lazy" decoding="async"
            />
          </div>
          <div class="space-y-2">
            <h3 class="font-serif text-2xl font-bold text-primary-dark uppercase tracking-tight">Crenças & Valores</h3>
            <p class="text-text-body/75 text-sm sm:text-base leading-relaxed">
              Pautamos nossas ações pela solidariedade, empatia ativa, transparência absoluta em todos os recursos recebidos, respeito incondicional à dignidade humana e compromisso sincero com o desenvolvimento social e comunitário.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ───── NOSSAS FRENTES (O QUE FAZEMOS) ───── -->
  <section id="o-que-fazemos" class="pt-24 sm:pt-32 md:pt-40 pb-16 md:pb-24 bg-white relative overflow-hidden">
    <!-- Linhas e formas decorativas (Estilo Vini Jr) -->
    <div class="decor-chevron-right bottom-24 -right-16"></div>
    <div class="decor-slanted-stripe-accent bottom-1/3 left-0"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="section-label mb-4 block w-fit mx-auto">Nossas Frentes</span>
        <h2 class="font-serif text-3xl md:text-4xl xl:text-5xl font-bold">O que fazemos</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Coluna Esquerda -->
        <div class="space-y-8">
          
          <!-- Card 1: Saúde (Vertical Grande) -->
          <div class="bg-primary-dark text-white rounded-3xl p-6 sm:p-8 border border-primary-dark/25 shadow-lg card-lift flex flex-col space-y-6 relative overflow-hidden">
            <div class="aspect-[16/10] rounded-2xl overflow-hidden relative">
              <Image src="https://i.ibb.co/QvjF1f6q/Whats-App-Image-2026-06-22-at-07-28-01-2.jpg" inferSize width={700} class="w-full h-full object-cover" alt="Saúde e Bem-estar" />
              <!-- Diagonal Corner Ribbon -->
              <div class="absolute -bottom-1.5 -right-6 w-20 h-5 bg-primary transform -rotate-45 opacity-75"></div>
              <div class="absolute -top-1.5 -left-6 w-20 h-5 bg-primary transform -rotate-45 opacity-75"></div>
            </div>
            <div class="space-y-3">
              <span class="text-[10px] uppercase font-bold tracking-widest text-primary bg-white/10 px-3 py-1 rounded-full border border-white/20">Saúde</span>
              <h3 class="font-serif text-2xl font-bold text-white">Saúde & Bem-estar</h3>
              <p class="text-white/85 text-sm sm:text-base leading-relaxed">
                Acreditamos que a saúde é a base para o desenvolvimento humano. Promovemos assistência médica preventiva, facilitando o acesso da comunidade a profissionais qualificados. Investimos na formação de agentes comunitários de saúde, multiplicando o cuidado.
              </p>
            </div>
          </div>

          <!-- Card 2: Esportes e Lazer (Vertical) -->
          <div class="bg-bg-offwhite rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm card-lift flex flex-col space-y-6 relative overflow-hidden">
            <div class="aspect-[16/10] rounded-2xl overflow-hidden relative">
              <Image src="https://i.ibb.co/vCh7NhmK/Whats-App-Image-2026-06-22-at-07-27-59-2.jpg" inferSize width={700} class="w-full h-full object-cover" alt="Esporte e Lazer" />
              <!-- Diagonal Corner Ribbon -->
              <div class="absolute -bottom-1.5 -right-6 w-20 h-5 bg-secondary transform -rotate-45 opacity-75"></div>
              <div class="absolute -top-1.5 -left-6 w-20 h-5 bg-secondary transform -rotate-45 opacity-75"></div>
            </div>
            <div class="space-y-3">
              <span class="text-[10px] uppercase font-bold tracking-widest text-primary-dark bg-secondary/30 px-3 py-1 rounded-full border border-secondary/50">ESPORTES</span>
              <h3 class="font-serif text-2xl font-bold text-gray-900">Esporte & Lazer</h3>
              <p class="text-text-body/75 text-sm sm:text-base leading-relaxed">
                Promovemos atividades físicas e recreativas integradas para toda a comunidade. Nossos focos principais de lazer incluem turmas de natação infantil e hidroginástica dedicada ao cuidado da saúde de idosos da região.
              </p>
            </div>
          </div>

          <!-- Card 6: Meio Ambiente (Vertical) -->
          <div class="bg-bg-offwhite rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm card-lift flex flex-col space-y-6 relative overflow-hidden">
            <div class="aspect-[16/10] rounded-2xl overflow-hidden relative">
              <Image src="https://i.ibb.co/DDWcrJ21/Whats-App-Image-2026-07-13-at-18-54-51.jpg" inferSize width={700} class="w-full h-full object-cover" alt="Meio Ambiente" />
              <!-- Diagonal Corner Ribbon -->
              <div class="absolute -bottom-1.5 -right-6 w-20 h-5 bg-primary transform -rotate-45 opacity-75"></div>
              <div class="absolute -top-1.5 -left-6 w-20 h-5 bg-primary transform -rotate-45 opacity-75"></div>
            </div>
            <div class="space-y-3">
              <span class="text-[10px] uppercase font-bold tracking-widest text-primary-dark bg-primary/20 px-3 py-1 rounded-full border border-primary/30">Meio Ambiente</span>
              <h3 class="font-serif text-2xl font-bold text-gray-900">Consciência & Sustentabilidade</h3>
              <p class="text-text-body/75 text-sm sm:text-base leading-relaxed">
                Integramos a educação ambiental ao nosso trabalho social, incentivando o reaproveitamento de materiais, hábitos sustentáveis e o cuidado com os espaços verdes da comunidade da Penha e região.
              </p>
            </div>
          </div>

        </div>

        <!-- Coluna Direita -->
        <div class="space-y-8">
          
          <!-- Card 3: Educação (Horizontal) -->
          <div class="bg-bg-offwhite rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm card-lift flex flex-col sm:flex-row gap-6 items-center relative overflow-hidden">
            <div class="w-full sm:w-1/3 aspect-[4/3] rounded-2xl overflow-hidden flex-shrink-0 relative">
              <Image src="https://i.ibb.co/8gYZqnX7/Whats-App-Image-2026-06-22-at-07-27-58-2.jpg" inferSize width={400} class="w-full h-full object-cover" alt="Educação" />
              <!-- Diagonal Corner Ribbon -->
              <div class="absolute -bottom-1.5 -right-6 w-16 h-4 bg-accent transform -rotate-45 opacity-75"></div>
            </div>
            <div class="flex-grow space-y-3">
              <span class="text-[10px] uppercase font-bold tracking-widest text-primary-dark bg-accent/15 px-3 py-1 rounded-full border border-accent/30">Educação</span>
              <h3 class="font-serif text-xl font-bold text-gray-900">Reforço Escolar & Apoio</h3>
              <p class="text-text-body/75 text-sm leading-relaxed">
                Apoiamos os alunos com aulas pedagógicas de reforço escolar, acesso gratuito à biblioteca comunitária equipada e palestras motivacionais e comportamentais para o desenvolvimento de jovens.
              </p>
            </div>
          </div>

          <!-- Card 4: Cultura (Horizontal) -->
          <div class="bg-primary/20 rounded-3xl p-6 sm:p-8 border border-primary/30 shadow-md card-lift flex flex-col sm:flex-row gap-6 items-center relative overflow-hidden">
            <div class="w-full sm:w-1/3 aspect-[4/3] rounded-2xl overflow-hidden flex-shrink-0 relative">
              <Image src="https://i.ibb.co/JPpm3ZD/Whats-App-Image-2026-06-22-at-07-28-01.jpg" inferSize width={400} class="w-full h-full object-cover" alt="Cultura" />
              <!-- Diagonal Corner Ribbon -->
              <div class="absolute -bottom-1.5 -right-6 w-16 h-4 bg-primary transform -rotate-45 opacity-75"></div>
            </div>
            <div class="flex-grow space-y-3">
              <span class="text-[10px] uppercase font-bold tracking-widest text-primary-dark bg-primary-dark/20 px-3 py-1 rounded-full border border-primary-dark/30">Cultura</span>
              <h3 class="font-serif text-xl font-bold text-primary-dark">Música & Oficinas</h3>
              <p class="text-primary-dark/85 text-sm leading-relaxed">
                Fomentamos a cultura carioca e a criatividade local através de aulas e inscrições abertas para oficinas de música, como pandeiro e cavaco, promovendo a inclusão através da arte.
              </p>
            </div>
          </div>

          <!-- Card 5: Assistência Social & Empregabilidade (Vertical) -->
          <div class="bg-bg-offwhite rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm card-lift flex flex-col space-y-6 relative overflow-hidden">
            <div class="aspect-[16/10] rounded-2xl overflow-hidden relative">
              <img src="/criancas_sorrindo.jpg" class="w-full h-full object-cover" alt="Assistência Social e Empregabilidade" />
              <!-- Diagonal Corner Ribbon -->
              <div class="absolute -bottom-1.5 -right-6 w-20 h-5 bg-secondary transform -rotate-45 opacity-75"></div>
              <div class="absolute -top-1.5 -left-6 w-20 h-5 bg-secondary transform -rotate-45 opacity-75"></div>
            </div>
            <div class="space-y-3">
              <span class="text-[10px] uppercase font-bold tracking-widest text-primary-dark bg-secondary/30 px-3 py-1 rounded-full border border-secondary/50">Social</span>
              <h3 class="font-serif text-2xl font-bold text-gray-900">Assistência & Empregabilidade</h3>
              <p class="text-text-body/75 text-sm sm:text-base leading-relaxed">
                Amparamos os moradores com isenção para segunda via de documentos, orientação jurídica para benefícios (INSS, Aposentadorias e LOAS), cadastro de PCD, e suporte com análise de currículos e encaminhamento profissional.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ───── DOAÇÕES ───── -->
  <section id="doacoes" class="py-24 bg-bg-offwhite relative overflow-hidden">
    <!-- Linhas e formas decorativas (Estilo Vini Jr) -->
    <div class="decor-chevron-left top-20 -left-12"></div>
    <div class="decor-slanted-stripe bottom-10 right-0"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
      
      <!-- Cabeçalho -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="section-label mb-4 block w-fit mx-auto">Apoie</span>
        <h2 class="font-serif text-3xl md:text-4xl xl:text-5xl font-bold mb-4">Como sua doação ajuda</h2>
        <p class="text-base sm:text-lg text-text-body/75">Sua contribuição é o combustível que nos permite continuar acolhendo vidas e multiplicando esperança na Penha e região.</p>
      </div>

