<script>
  function initHeroSlideshow() {
    const slideshow = document.getElementById('hero-slideshow');
    if (!slideshow) return;

    const slides = slideshow.querySelectorAll('.slideshow-slide');
    if (slides.length <= 1) return;

    let currentIndex = 0;

    function nextSlide() {
      const currentSlide = slides[currentIndex];
      
      currentIndex = (currentIndex + 1) % slides.length;
      const nextSlide = slides[currentIndex];

      // Remove classes
      currentSlide.classList.remove('active', 'opacity-100');
      currentSlide.classList.add('opacity-0');

      // Adiciona classes
      nextSlide.classList.remove('opacity-0');
      nextSlide.classList.add('active', 'opacity-100');
    }

    setInterval(nextSlide, 5000);
  }

  document.addEventListener('DOMContentLoaded', initHeroSlideshow);
  document.addEventListener('astro:page-load', initHeroSlideshow);
</script>

<script>
  function initCarousel(opts: { carouselId: string; prevId: string; nextId: string; dotsId: string; itemAttr: string; scrollAmount: number }) {
    const carousel = document.getElementById(opts.carouselId);
    const prevBtn = document.getElementById(opts.prevId);
    const nextBtn = document.getElementById(opts.nextId);
    const dots = document.querySelectorAll<HTMLButtonElement>(`#${opts.dotsId} [data-dot]`);

    if (!carousel) return;

    const cards = carousel.querySelectorAll<HTMLElement>(`[${opts.itemAttr}]`);

    function getActiveIndex(): number {
      const mid = carousel!.scrollLeft + carousel!.clientWidth / 2;
      let closest = 0;
      let minDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft + card.offsetWidth / 2 - mid);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      return closest;
    }

    function updateDots(active: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-primary-dark', i === active);
        dot.classList.toggle('w-4', i === active);
        dot.classList.toggle('bg-primary/30', i !== active);
        dot.classList.toggle('w-2', i !== active);
      });
    }

    carousel.addEventListener('scroll', () => { updateDots(getActiveIndex()); }, { passive: true });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        cards[i]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      });
    });

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => { carousel!.scrollBy({ left: -opts.scrollAmount, behavior: 'smooth' }); });
      nextBtn.addEventListener('click', () => { carousel!.scrollBy({ left: opts.scrollAmount, behavior: 'smooth' }); });
    }

    updateDots(0);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initCarousel({ carouselId: 'actions-carousel', prevId: 'prev-action', nextId: 'next-action', dotsId: 'carousel-dots', itemAttr: 'data-card-index', scrollAmount: 380 });
    initCarousel({ carouselId: 'photos-carousel', prevId: 'prev-photo', nextId: 'next-photo', dotsId: 'photos-dots', itemAttr: 'data-photo-index', scrollAmount: 300 });
  });
</script>

<script>
  function initPixKeyCopier() {
    const copyBtn = document.getElementById('copy-cnpj-btn');
    const pixKey = document.getElementById('cnpj-key');

    if (copyBtn && pixKey) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pixKey.textContent || '');
          const span = copyBtn.querySelector('span');
          if (span) {
            const originalText = span.textContent;
            span.textContent = 'Copiado! ✓';
            copyBtn.classList.add('bg-green-600', 'text-white');
            copyBtn.classList.remove('bg-primary', 'text-primary-dark');
            setTimeout(() => {
              span.textContent = originalText;
              copyBtn.classList.remove('bg-green-600', 'text-white');
              copyBtn.classList.add('bg-primary', 'text-primary-dark');
            }, 2000);
          }
        } catch (err) {
          console.error('Falha ao copiar chave PIX:', err);
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initPixKeyCopier);
  document.addEventListener('astro:page-load', initPixKeyCopier);
</script>
