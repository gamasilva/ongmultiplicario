<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Donation toggle script
    const btnMonthly = document.getElementById('toggle-monthly');
    const btnOneTime = document.getElementById('toggle-one-time');
    const monthlyTiers = document.getElementById('monthly-tiers');
    const oneTimeTiers = document.getElementById('one-time-tiers');

    if (btnMonthly && btnOneTime && monthlyTiers && oneTimeTiers) {
      btnMonthly.addEventListener('click', () => {
        monthlyTiers.classList.remove('hidden');
        oneTimeTiers.classList.add('hidden');
        
        btnMonthly.classList.add('bg-primary-dark', 'text-white');
        btnMonthly.classList.remove('bg-white', 'text-text-body', 'border-gray-200');
        
        btnOneTime.classList.remove('bg-primary-dark', 'text-white');
        btnOneTime.classList.add('bg-white', 'text-text-body', 'border-gray-200');
      });

      btnOneTime.addEventListener('click', () => {
        oneTimeTiers.classList.remove('hidden');
        monthlyTiers.classList.add('hidden');
        
        btnOneTime.classList.add('bg-primary-dark', 'text-white');
        btnOneTime.classList.remove('bg-white', 'text-text-body', 'border-gray-200');
        
        btnMonthly.classList.remove('bg-primary-dark', 'text-white');
        btnMonthly.classList.add('bg-white', 'text-text-body', 'border-gray-200');
      });
    }
  });
</script>
