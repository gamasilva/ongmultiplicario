---
import '../styles/global.css';
import '@fontsource-variable/rubik';
import '@fontsource-variable/bricolage-grotesque';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	fullTitle?: string;
	description?: string;
	keywords?: string;
	image?: string;
	imageAlt?: string;
	heroImage?: string;
}

const SITE = 'https://imultiplicario.org.br';

const {
  title,
  fullTitle,
  description = "Instituto MultiplicaRio — instituto sem fins lucrativos que atua em educação, saúde, cultura e assistência social na Penha, Rio de Janeiro.",
  keywords = "MultiplicaRio, Instituto MultiplicaRio, ONG Penha, ONG Rio de Janeiro, saúde comunitária, assistência social, educação, OSCIP, voluntariado Rio de Janeiro",
  image = "https://i.ibb.co/8g4DS0jR/Whats-App-Image-2026-06-22-at-07-28-01-2.jpg",
  imageAlt = "Voluntários e comunidade em ação com o Instituto MultiplicaRio na Penha, Rio de Janeiro",
  heroImage
} = Astro.props;

const pageTitle = fullTitle ?? `${title} | Instituto MultiplicaRio`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE);
const ogImageURL = new URL(image, canonicalURL);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NGO",
      "@id": `${SITE}/#organization`,
      "name": "Instituto MultiplicaRio",
      "legalName": "Instituto de Desenvolvimento Social Cultural de Esporte e Lazer MultiplicaRio",
      "alternateName": ["MultiplicaRio", "MultiplicaRio Penha", "imultiplicario"],
      "url": SITE,
      "foundingDate": "2014",
      "slogan": "Ajudando a cuidar de vidas e multiplicar esperança.",
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE}/favicon.svg`,
        "width": 512,
        "height": 512
      },
      "image": `${SITE}/criancas_sorrindo.jpg`,
      "description": "Instituto sem fins lucrativos que promove o bem-estar e o desenvolvimento social em educação, saúde, cultura, esportes, lazer, meio ambiente e assistência social na Penha e região, Rio de Janeiro. Todos os serviços são 100% gratuitos.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Montevideo, 824, Loja F",
        "addressLocality": "Penha",
        "addressRegion": "RJ",
        "postalCode": "21020-290",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -22.8265,
        "longitude": -43.2863
      },
      "telephone": "+55-21-96459-4790",
      "email": "imultiplicar@gmail.com",
      "taxID": "62.559.044/0001-03",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "areaServed": [
        { "@type": "City", "name": "Rio de Janeiro", "sameAs": "https://www.wikidata.org/wiki/Q8678" },
        { "@type": "Neighborhood", "name": "Penha" },
        { "@type": "Neighborhood", "name": "Penha Circular" },
        { "@type": "Neighborhood", "name": "Brás de Pina" }
      ],
      "knowsAbout": [
        "educação social", "saúde comunitária", "assistência social",
        "esporte e lazer", "cultura popular", "empoderamento feminino",
        "orientação jurídica INSS", "LOAS", "BPC", "saúde mental",
        "meio ambiente", "desenvolvimento sustentável"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços Comunitários Gratuitos",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Aferição de Pressão Arterial", "serviceType": "Saúde" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Teste Glicêmico", "serviceType": "Saúde" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Reflexologia", "serviceType": "Saúde e Bem-estar" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Apoio Emocional e Escuta Qualificada", "serviceType": "Saúde Mental" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Orientação Jurídica INSS, LOAS e BPC", "serviceType": "Assistência Social" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Empoderamento Feminino", "serviceType": "Assistência Social" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Atendimento Terapêutico para Mulheres", "serviceType": "Saúde Mental" } }
        ]
      },
      "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 1 },
      "sameAs": [
        SITE,
        "https://www.facebook.com/institutomultiplicario",
        "https://www.instagram.com/institutomultiplicario"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Instituto MultiplicaRio",
      "description": "Site oficial do Instituto MultiplicaRio — instituto sem fins lucrativos que atua em saúde, educação, cultura e assistência social na Penha, Rio de Janeiro.",
      "publisher": { "@id": `${SITE}/#organization` },
      "inLanguage": "pt-BR"
    }
  ]
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
		<link rel="mask-icon" href="/favicon.svg" color="#2F4A3A" />
		<meta name="theme-color" content="#2F4A3A" />
		<meta name="generator" content={Astro.generator} />

    <!-- SEO -->
		<title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Instituto MultiplicaRio" />
    <meta name="publisher" content="Instituto MultiplicaRio" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- GEO / Local SEO -->
    <meta name="geo.region" content="BR-RJ" />
    <meta name="geo.placename" content="Penha, Rio de Janeiro, Brasil" />
    <meta name="geo.position" content="-22.8265;-43.2863" />
    <meta name="ICBM" content="-22.8265, -43.2863" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Instituto MultiplicaRio" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- JSON-LD base (NGO + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Slot para schema adicional por página (FAQPage, BreadcrumbList, etc.) -->
    <slot name="head" />

    <!-- Preconnect para imagens externas -->
    <link rel="preconnect" href="https://i.ibb.co" crossorigin />
    <link rel="dns-prefetch" href="https://i.ibb.co" />

    <!-- Preload da imagem hero quando fornecida pela página -->
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
	</head>
	<body class="flex flex-col min-h-screen">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary text-bg-offwhite px-4 py-2 rounded-md z-50">
      Pular para conteúdo principal
    </a>

    <Header />

		<main id="main-content" class="flex-grow">
			<slot />
		</main>

    <Footer />
	</body>
</html>
