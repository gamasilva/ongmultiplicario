---
import DonateButton from './DonateButton.astro';

interface Props {
  title?: string;
  subtitle?: string;
  primaryButtonText?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
}

const {
  title = "Faça parte dessa transformação",
  subtitle = "Sua contribuição é fundamental para continuarmos multiplicando esperança na Penha e no Rio de Janeiro. Cada doação importa.",
  primaryButtonText = "Quero Doar",
  secondaryButtonText = "Conheça nossas ações",
  secondaryButtonHref = "/areas-de-atuacao"
} = Astro.props;
---

<section class="py-20 md:py-28 bg-white relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
    <div class="relative bg-gradient-to-br from-primary-dark via-primary-dark to-[#1d3025] rounded-[2.5rem] p-8 sm:p-12 md:p-16 overflow-hidden shadow-2xl ring-1 ring-white/10">
      
      <!-- Círculos e gradientes decorativos no fundo -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-secondary/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-16 -left-16 w-72 h-72 bg-accent/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute inset-0 dot-pattern opacity-10 pointer-events-none"></div>

      <div class="relative z-10 flex flex-col items-center text-center space-y-6 md:space-y-8 max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold tracking-[0.14em] uppercase text-secondary bg-white/10 px-4 py-1.5 rounded-full border border-white/10">
          ✦ MultiplicaRio
        </span>
        
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-white leading-tight">
          {title}
        </h2>
        
        <p class="text-white/80 text-base sm:text-lg md:text-xl leading-relaxed max-w-2xl">
          {subtitle}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4 w-full">
          <DonateButton variant="secondary" class="w-full sm:w-auto justify-center text-lg px-8 py-4 bg-white text-rose hover:bg-white/90 border-none" />
          <a
            href={secondaryButtonHref}
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 bg-transparent border-2 border-white/30 text-white hover:bg-white/10 hover:border-white/50 px-8 py-4 rounded-full font-bold transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white focus-visible:ring-offset-primary-dark text-lg"
          >
            {secondaryButtonText}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
