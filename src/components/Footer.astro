---
import { Facebook, Instagram, MessageCircle } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark relative overflow-visible mt-24 pt-20 pb-10 text-white border-t-4 border-secondary/20">
  
  <!-- Imagem Sobreposta Estilizada (Estilo Cutout Vini Jr) -->
  <div class="hidden lg:block absolute bottom-0 right-16 w-60 h-[120%] z-20 pointer-events-none transform translate-y-10">
    <img
      src="/criancas_sorrindo.jpg"
      width="240"
      height="288"
      class="w-full h-full object-cover rounded-t-[3rem] border-t-8 border-x-8 border-white shadow-[0_-20px_50px_rgba(0,0,0,0.3)] bg-white"
      alt="Instituto MultiplicaRio Crianças Sorrindo"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Container de Conteúdo -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 items-center">
      
      <!-- Coluna 1: Nome do Instituto -->
      <div class="flex flex-col items-center md:items-start space-y-3 text-center md:text-left">
        <div class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-white whitespace-nowrap">
          Instituto <span class="text-primary">MultiplicaRio</span>
        </div>
        <p class="text-xs tracking-widest uppercase font-sans font-bold text-white/80 max-w-[240px] leading-relaxed">
          UM TRABALHO DE LONGO PRAZO, TRANSFORMADOR.
        </p>
      </div>

      <!-- Coluna 2: Links Institucionais e LGPD -->
      <div class="flex flex-col space-y-4 font-sans font-bold text-xs tracking-widest text-white uppercase text-center md:text-left">
        <a href="/#sobre" class="hover:underline underline-offset-4 decoration-secondary transition-all">
          Quem Somos
        </a>
        <a href="/#o-que-fazemos" class="hover:underline underline-offset-4 decoration-secondary transition-all">
          Nossas Frentes
        </a>
        <a href="/#transparencia" class="hover:underline underline-offset-4 decoration-secondary transition-all">
          Transparência & Relatórios
        </a>
        <a href="/#contato" class="hover:underline underline-offset-4 decoration-secondary transition-all">
          Fale Conosco
        </a>
      </div>

      <!-- Coluna 3: Redes Sociais + Voltar ao topo -->
      <div class="flex flex-col items-center md:items-start space-y-5 lg:pr-24">
        <span class="text-[10px] uppercase font-bold tracking-[0.2em] text-white/80">Siga nossas redes</span>
        
        <div class="flex items-center gap-3">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/institutomultiplicario"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-white/10 hover:bg-white/20 hover:scale-105 active:scale-95 rounded-full flex items-center justify-center text-white transition-all duration-200 shadow-md"
            aria-label="Instagram"
          >
            <Instagram class="w-5 h-5" aria-hidden="true" />
          </a>
          
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/institutomultiplicario"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-white/10 hover:bg-white/20 hover:scale-105 active:scale-95 rounded-full flex items-center justify-center text-white transition-all duration-200 shadow-md"
            aria-label="Facebook"
          >
            <Facebook class="w-5 h-5" aria-hidden="true" />
          </a>
          
          <!-- WhatsApp -->
          <a
            href="https://wa.me/552164594790"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-white/10 hover:bg-white/20 hover:scale-105 active:scale-95 rounded-full flex items-center justify-center text-white transition-all duration-200 shadow-md"
            aria-label="WhatsApp"
          >
            <MessageCircle class="w-5 h-5" aria-hidden="true" />
          </a>
        </div>

        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="border-2 border-white/30 text-white font-sans font-bold text-[9px] tracking-widest uppercase py-2.5 px-6 rounded-full hover:bg-white hover:text-primary-dark transition-all duration-300 active:scale-95 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white shadow-sm"
        >
          Voltar ao topo ↑
        </button>
      </div>

    </div>

    <!-- Linha de Direitos Autorais e CNPJ -->
    <div class="pt-8 mt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-[9px] tracking-widest text-white/80 uppercase font-sans">
      <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
        <p>&copy; {currentYear} INSTITUTO MULTIPLICARIO. TODOS OS DIREITOS RESERVADOS.</p>
        <span class="hidden sm:inline text-white/20">·</span>
        <p class="font-mono">CNPJ: 62.559.044/0001-03</p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
        <p>Feito para a Penha, RJ</p>
        <span class="hidden sm:inline text-white/20">·</span>
        <p>
          Desenvolvido por 
          <a
            href="https://www.autosocialflow.com.br/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-white hover:text-secondary transition-colors"
          >
            Auto Social Flow
          </a>
        </p>
      </div>
    </div>

  </div>
</footer>
