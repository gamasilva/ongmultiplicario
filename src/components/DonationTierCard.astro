---
interface Props {
  amount: string;
  impact: string;
  isPopular?: boolean;
}

const { amount, impact, isPopular = false } = Astro.props;
---

<div class={`relative flex flex-col p-8 rounded-3xl border transition-all duration-300 ${
  isPopular 
    ? 'border-primary bg-gradient-to-b from-white to-primary/5 shadow-xl md:scale-105 z-10 -translate-y-1' 
    : 'border-gray-200 bg-white/70 backdrop-blur-md shadow-sm hover:border-primary/30'
} hover:-translate-y-2 hover:shadow-2xl`}>
  {isPopular && (
    <div class="absolute -top-4 left-1/2 -translate-x-1/2 text-xs font-extrabold uppercase tracking-[0.12em] py-1.5 px-4 rounded-full bg-primary text-white shadow-md flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 bg-white rounded-full animate-ping"></span>
      Mais Escolhido
    </div>
  )}
  
  <div class="text-center mb-6 pt-3">
    <span class="text-primary-dark/75 font-bold text-lg font-serif">R$</span>
    <span class={`font-serif text-6xl font-black tracking-tight ${isPopular ? 'text-primary-dark' : 'text-gray-900'}`}>{amount}</span>
  </div>
  
  <p class="text-text-body/80 text-center mb-8 flex-grow text-sm sm:text-base leading-relaxed">
    {impact}
  </p>
  
  <a 
    href={`/como-ajudar?amount=${amount}`}
    class={`w-full text-center py-3.5 rounded-full font-bold transition-all duration-200 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 ${
      isPopular 
        ? 'bg-rose text-white hover:bg-rose-dark shadow-md hover:shadow-rose/30 focus-visible:ring-rose' 
        : 'bg-white border-2 border-primary-dark text-primary-dark hover:bg-primary-dark hover:text-white shadow-sm focus-visible:ring-primary-dark'
    }`}
  >
    Doar R$ {amount}
  </a>
</div>
